            {
              "id": "c2",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              },
              "leftValue": "={{ $json.query.account }}",
              "rightValue": ""
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "c38ca528-6a90-4ed4-beed-ca0979503f72",
      "name": "Go to TikTok",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        440,
        -100
      ],
      "parameters": {
        "respondWith": "redirect",
        "redirectURL": "={{ 'https://www.tiktok.com/v2/auth/authorize/?client_key=' + $env.TIKTOK_CLIENT_KEY + '&scope=' + encodeURIComponent('user.info.basic,video.publish') + '&response_type=code&redirect_uri=' + encodeURIComponent('https://' + $env.N8N_HOST + '/webhook/tiktok-callback') + '&state=' + encodeURIComponent($json.query.account) }}",
        "options": {}
