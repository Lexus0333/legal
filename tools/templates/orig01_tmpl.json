      "name": "Exchange code for tokens",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        400
      ],
      "parameters": {
        "method": "POST",
        "url": "https://open.tiktokapis.com/v2/oauth/token/",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/x-www-form-urlencoded"
            }
          ]
        },
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "client_key",
              "value": "={{ $env.TIKTOK_CLIENT_KEY }}"
            },
            {
              "name": "client_secret",
              "value": "={{ $env.TIKTOK_CLIENT_SECRET }}"
            },
            {
              "name": "code",
              "value": "={{ $json.query.code }}"
            },
            {
              "name": "grant_type",
              "value": "authorization_code"
            },
            {
              "name": "redirect_uri",
              "value": "={{ 'https://' + $env.N8N_HOST + '/webhook/tiktok-callback' }}"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "fb2f690b-89e1-4b82-9e47-55d5e01e503d",
      "name": "Build row",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        400
      ],
      "parameters": {
        "jsCode": "const t = $input.first().json;\nif (!t.access_token) throw new Error('TikTok did not return a token: ' + JSON.stringify(t));\nconst account = $('Callback (GET)').first().json.query.state;\nconst now = Date.now();\nreturn [{ json: {\n  account,\n  open_id: t.open_id,\n  access_token: t.access_token,\n  refresh_token: t.refresh_token,\n  access_expires_at: now + t.expires_in * 1000,\n  refresh_expires_at: now + t.refresh_expires_in * 1000,\n}}];"
      }
    },
    {
      "id": "bbe69f73-031d-4d1e-ae91-69ec7aa8fb2b",
      "name": "Save account (upsert)",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "position": [
        660,
        400
      ],
      "parameters": {
        "operation": "upsert",
        "dataTableId": {
          "__rl": true,
          "mode": "name",
          "value": "tiktok_accounts"
        },
        "filters": {
          "conditions": [
            {
              "keyName": "account",
              "condition": "eq",
              "keyValue": "={{ $json.account }}"
            }
          ]
        },
        "columns": {
          "mappingMode": "autoMapInputData",
          "value": {},
          "matchingColumns": [],
          "schema": []
        },
        "options": {}
      }
    },
    {
      "id": "5c2b2caa-d3fc-41c9-bdeb-e88b3c6e9f60",
      "name": "Done page",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        880,
        400
      ],
      "parameters": {
        "respondWith": "text",
        "responseBody": "=<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Account connected</title></head><body style=\"font-family:system-ui,sans-serif;max-width:560px;margin:60px auto;padding:0 16px;line-height:1.6;color:#1d2129\"><h1>Account connected</h1><p>TikTok account <b>{{ $('Build row').first().json.account.replace(/[&<>\"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c])) }}</b> is now connected to EXE Agency Publisher.</p><p><a href=\"https://lexus0333.github.io/legal/console.html\">Back to the console</a></p></body></html>",
        "options": {
          "responseHeaders": {
            "entries": [
              {
                "name": "Content-Type",
                "value": "text/html; charset=utf-8"
              }
            ]
          }
        }
      }
    }
