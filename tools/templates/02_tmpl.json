      ],
      "parameters": {
        "jsCode": "// Берём одну готовую к публикации строку (время публикации наступило).\nconst now = Date.now();\nconst rows = $input.all().map(i => i.json).filter(r =>\n  String(r.status || '').trim() === 'Ready' &&\n  (!r.publish_at || new Date(r.publish_at).getTime() <= now));\nif (!rows.length) return [];\nconst r = rows[0];\nconst m = String(r.drive_url || '').match(/\\/d\\/([\\w-]+)|[?&]id=([\\w-]+)/);\nif (!m) throw new Error('Row ' + r.row_number + ': cannot read Drive file id from drive_url');\nif (!String(r.account || '').trim()) throw new Error('Row ' + r.row_number + ': account is empty');\nif (!String(r.hook || '').trim()) throw new Error('Row ' + r.row_number + ': hook is empty');\nreturn [{ json: { ...r,\n  rid: Number(r.row_number),\n  file_id: m[1] || m[2],\n  trim: Math.max(0, Number(r.trim_start) || 0),\n  maxlen: Math.max(0, Number(r.max_len) || 0),\n}}];"
      }
