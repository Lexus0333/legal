    {
      "id": "0b74ad1b-d616-4e96-9f18-47e107a92bc5",
      "name": "Token logic",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2640,
        0
      ],
      "parameters": {
        "jsCode": "// Берём токен аккаунта; если скоро истекает - обновляем через refresh_token.\nconst cfg = $('Config').first().json;\nconst acc = $('Pick next').first().json.account;\nconst row = $input.first().json;\nif (!row || !row.access_token) throw new Error('Account \"' + acc + '\" is not connected. Open the connect link (workflow 01).');\nconst now = Date.now();\nif (Number(row.refresh_expires_at) < now) throw new Error('Refresh token expired for \"' + acc + '\". Reconnect the account.');\nlet t = { access_token: row.access_token, refresh_token: row.refresh_token, access_expires_at: Number(row.access_expires_at), refresh_expires_at: Number(row.refresh_expires_at) };\nif (t.access_expires_at - now < 10 * 60 * 1000) {\n  const body = new URLSearchParams({ client_key: cfg.client_key, client_secret: cfg.client_secret, grant_type: 'refresh_token', refresh_token: row.refresh_token }).toString();\n  const r = await this.helpers.httpRequest({ method: 'POST', url: 'https://open.tiktokapis.com/v2/oauth/token/', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body, json: true });\n  if (!r.access_token) throw new Error('Token refresh failed: ' + JSON.stringify(r));\n  t = { access_token: r.access_token, refresh_token: r.refresh_token || row.refresh_token, access_expires_at: now + r.expires_in * 1000, refresh_expires_at: r.refresh_expires_in ? now + r.refresh_expires_in * 1000 : t.refresh_expires_at };\n}\nreturn [{ json: { account: acc, ...t } }];"
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "1cadca26-0b4d-4eef-b84d-194551d32693",
