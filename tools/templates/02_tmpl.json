    {
      "id": "7af79307-1c79-4ff8-bd03-82374281529b",
      "name": "Gemini caption",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        3080,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-3.8-flash:generateContent",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ contents: [{ parts: [{ text: 'Write a TikTok caption for a video. Topic: ' + $('Pick next').first().json.topic + '. On-screen hook: ' + $('Pick next').first().json.hook + '. Use the same language as the hook. Caption up to 120 characters, no hashtags inside it, plus 3-5 relevant hashtags. No false claims. Reply as JSON: {\"caption\": string, \"hashtags\": [string]}' }] }], generationConfig: { responseMimeType: 'application/json' } }) }}",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "Gemini API key (header x-goog-api-key)"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "ba7eb25c-a67d-4bf3-9255-1e83535174bf",
      "name": "Read variant",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [
        3300,
        0
      ],
      "parameters": {
        "operation": "read",
        "fileSelector": "=/files/out/{{ $('Pick next').first().json.rid }}/{{ $('Pick next').first().json.rid }}_v1.mp4",
        "options": {}
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "50bbab53-f3fc-4886-91b3-3036a17458d4",
      "name": "Upload to TikTok",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3520,
        0
      ],
      "parameters": {
        "jsCode": "const cfg = $('Config').first().json;\nconst tok = $('Token logic').first().json.access_token;\nconst row = $('Pick next').first().json;\nconst g = $('Gemini caption').first().json;\n\nlet cap = { caption: row.topic || '', hashtags: [] };\ntry { cap = JSON.parse(g.candidates[0].content.parts[0].text); } catch (e) { /* оставляем тему как подпись */ }\nconst tags = (cap.hashtags || []).map(h => '#' + String(h).replace(/^#/, '').replace(/\\s+/g, '')).join(' ');\nconst title = (String(cap.caption || '') + ' ' + tags).trim().slice(0, 2200);\n\nconst fs0 = require('fs');\nconst size = fs0.statSync('/files/out/' + row.rid + '/' + row.rid + '_v1.mp4').size;\nconst api = async (path, body) => {\n  try {\n    return await this.helpers.httpRequest({ method: 'POST', url: 'https://open.tiktokapis.com' + path,\n      headers: { Authorization: 'Bearer ' + tok, 'Content-Type': 'application/json; charset=UTF-8' }, body, json: true });\n  } catch (e) {\n    const b = (e.response && (e.response.body || e.response.data)) || (e.context && e.context.data) || e.description || '';\n    throw new Error(path + ': ' + e.message + ' ' + (typeof b === 'string' ? b : JSON.stringify(b)).slice(0, 500));\n  }\n};\nconst check = (r, what) => { if (r.error && r.error.code && r.error.code !== 'ok') throw new Error(what + ': ' + JSON.stringify(r.error)); return r; };\n\nconst info = check(await api('/v2/post/publish/creator_info/query/', {}), 'creator_info');\nconst allowed = (info.data && info.data.privacy_level_options) || [];\nconst privacy = cfg.privacy;\nif (allowed.length && !allowed.includes(privacy)) throw new Error('Privacy ' + privacy + ' not allowed for this account now. Allowed: ' + allowed.join(', '));\n\n// Правила TikTok: до 64 MB - одним куском; больше - куски по 32 MB, остаток уходит в последний.\nconst MB = 1024 * 1024;\nlet chunk = size, count = 1;\nif (size > 64 * MB) { chunk = 32 * MB; count = Math.floor(size / chunk); }\n\nconst init = check(await api('/v2/post/publish/video/init/', {\n  post_info: { title, privacy_level: privacy, disable_duet: false, disable_comment: false, disable_stitch: false, is_aigc: true },\n  source_info: { source: 'FILE_UPLOAD', video_size: size, chunk_size: chunk, total_chunk_count: count },\n}), 'init');\nconst { publish_id, upload_url } = init.data;\n\nconst fs = require('fs');\nconst https = require('https');\nconst filePath = '/files/out/' + row.rid + '/' + row.rid + '_v1.mp4';\nconst putChunk = (start, end) => new Promise((resolve, reject) => {\n  const m = String(upload_url).match(/^https:\\/\\/([^\\/]+)(\\/.*)$/);\n  if (!m) return reject(new Error('bad upload_url'));\n  const req = https.request({ method: 'PUT', hostname: m[1], path: m[2],\n    headers: { 'Content-Type': 'video/mp4', 'Content-Length': end - start + 1, 'Content-Range': 'bytes ' + start + '-' + end + '/' + size } },\n    res => { let b = ''; res.on('data', d => { b += d; }); res.on('end', () => (res.statusCode < 300 ? resolve() : reject(new Error('HTTP ' + res.statusCode + ' ' + b.slice(0, 300))))); });\n  req.on('error', reject);\n  fs.createReadStream(filePath, { start, end }).pipe(req);\n});\nfor (let i = 0; i < count; i++) {\n  const start = i * chunk;\n  const end = i === count - 1 ? size - 1 : start + chunk - 1;\n  let lastErr = '';\n  for (let attempt = 1; attempt <= 3; attempt++) {\n    try { await putChunk(start, end); lastErr = ''; break; }\n    catch (e) { lastErr = 'upload chunk ' + (i + 1) + '/' + count + ' attempt ' + attempt + ': ' + e.message; await new Promise(r => setTimeout(r, 5000)); }\n  }\n  if (lastErr) throw new Error(lastErr);\n}\n\nlet status = 'PROCESSING_UPLOAD', fail = '';\nfor (let k = 0; k < 30; k++) {\n  await new Promise(r => setTimeout(r, 6000));\n  const s = check(await api('/v2/post/publish/status/fetch/', { publish_id }), 'status');\n  status = s.data && s.data.status;\n  if (['PUBLISH_COMPLETE', 'FAILED', 'SEND_TO_USER_INBOX'].includes(status)) { fail = (s.data && s.data.fail_reason) || ''; break; }\n}\nif (status === 'FAILED') throw new Error('TikTok FAILED: ' + fail);\nreturn [{ json: { publish_id, tiktok_status: status, title, privacy,\n  params: JSON.stringify({ hook: row.hook, trim_start: row.trim, max_len: row.maxlen, hook_secs: 2.5, account: row.account }) } }];"
      },
      "onError": "continueErrorOutput"
    },
