# Скопируйте в .env (cp .env.example .env) и заполните НА СЕРВЕРЕ.
# Файл .env никому не показывайте и не выкладывайте в интернет.

# Поддомен, который вы направили на IP сервера (без https://)
N8N_HOST=n8n.example.com

# Версию уточните на https://hub.docker.com/r/n8nio/n8n/tags (берите конкретный номер, не latest)
N8N_VERSION=2.31.6

# Часовой пояс (важно для расписаний)
TZ=Europe/Moscow

# Пароль базы данных. Сгенерировать: openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME

# Ключ шифрования credentials n8n. Сгенерировать: openssl rand -hex 32
# ВАЖНО: сохраните его отдельно (менеджер паролей). Потеряете - потеряете все сохранённые доступы.
N8N_ENCRYPTION_KEY=CHANGE_ME

# --- TikTok (из developers.tiktok.com -> ваше приложение -> App details) ---
TIKTOK_CLIENT_KEY=CHANGE_ME
TIKTOK_CLIENT_SECRET=CHANGE_ME
# До прохождения аудита TikTok разрешён только SELF_ONLY. После аудита: PUBLIC_TO_EVERYONE
TIKTOK_PRIVACY=SELF_ONLY
# Длинный случайный пароль для ссылки подключения аккаунтов: openssl rand -hex 16
CONNECT_SECRET=CHANGE_ME
# ID вашего чата в Telegram (для уведомлений об ошибках), можно оставить пустым
TELEGRAM_CHAT_ID=

# Макс. случайная задержка перед публикацией, секунд (900 = до 15 минут). Для тестов поставьте 5
POST_JITTER_SEC=900

# ngrok (только для запуска на своём ПК): токен из dashboard.ngrok.com/get-started/your-authtoken
# В режиме ngrok N8N_HOST = ваш бесплатный домен вида что-то.ngrok-free.app
NGROK_AUTHTOKEN=

# --- Публикация из папки inbox (воркфлоу 04) ---
# ИИ пишет хук и подпись по кадрам видео. Нужен любой сервис с OpenAI-совместимым API, доступный из вашего региона
# (например OpenRouter: https://openrouter.ai/api/v1 ; модель с поддержкой изображений). Если пусто - текст берётся из файла .txt рядом с видео или из имени файла.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# Язык хуков и подписей (по умолчанию: язык подсказки в .txt, иначе русский)
AI_LANGUAGE=
# Аккаунт для видео, лежащих прямо в inbox (без подпапки аккаунта)
DEFAULT_ACCOUNT=account1
# Пауза между постами при публикации нескольких видео подряд, секунд (случайная между min и max)
POST_PAUSE_MIN_SEC=300
POST_PAUSE_MAX_SEC=900
# Сколько видео публиковать за одно нажатие кнопки (защита от случайной публикации всей папки)
MAX_POSTS_PER_RUN=5
# Общая подпись и хэштеги, если у видео нет .txt и ИИ не настроен (хэштеги через пробел, без #)
DEFAULT_CAPTION=
DEFAULT_HASHTAGS=
# Язык пулов хуков, подписей и хэштегов (папки infra/files/pools/en и /ru): en или ru
POOL_LANG=en
# 1 = тестовый прогон: всё делается, но в TikTok ничего не отправляется, видео возвращается в inbox
DRY_RUN=0

# --- Музыка (папка infra/files/music/<настроение>/ с треками, на которые у вас есть права) ---
# off - не добавлять; silent - только к видео без звука (по умолчанию); mix - и к видео со звуком (тише оригинала)
MUSIC_MODE=silent
# Громкость музыки (1 = обычная, 0.5 = вдвое тише)
MUSIC_VOLUME=1
# Дорожка тише этого уровня (дБ) считается беззвучной
MUSIC_SILENCE_DB=-45
# Пороги подбора настроения: движение выше MOOD_MOTION_HIGH = energetic; яркость ниже MOOD_LUMA_DARK = mysterious; иначе calm
MOOD_MOTION_HIGH=10
MOOD_LUMA_DARK=105

# --- Прочее ---
# Адрес сайта с панелью и страницами политики (для ссылок на страницах подключения)
SITE_URL=https://lexus0333.github.io/legal
# Метка «создано ИИ» на публикациях (1 = ставить, 0 = не ставить; для отдельного аккаунта переключается в панели)
AIGC_LABEL=1
# Адрес пульса для внешнего мониторинга (например healthchecks.io): раз в минуту планировщик обращается к нему, при молчании сервис пришлёт оповещение
HEARTBEAT_URL=
